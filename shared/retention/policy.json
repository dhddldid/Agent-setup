{
  "schema_version": 1,
  "conversation_days": 90,
  "keep_latest_default": 3,
  "schedule": {
    "weekday": 0,
    "hour": 4,
    "minute": 30
  },
  "builtin": [
    {
      "id": "hermes-sessions",
      "executor": "hermes",
      "setting": "sessions.retention_days",
      "value": 90,
      "also": {
        "sessions.auto_prune": true
      }
    },
    {
      "id": "claude-transcripts",
      "executor": "claude",
      "setting": "cleanupPeriodDays",
      "value": 90
    },
    {
      "id": "hermes-scratch",
      "executor": "hermes",
      "setting": "built-in 24h prune of {hermes_home}/cache/scratch",
      "value": 1
    }
  ],
  "items": [
    {
      "id": "codex-sessions",
      "executor": "codex",
      "root": "{codex_home}/sessions",
      "select": "files",
      "glob": "**/rollout-*.jsonl",
      "days": 90,
      "keep_latest": 3
    },
    {
      "id": "codex-archived-sessions",
      "executor": "codex",
      "root": "{codex_home}/archived_sessions",
      "select": "files",
      "glob": "**/*.jsonl",
      "days": 90,
      "keep_latest": 3
    },
    {
      "id": "codex-generated-images",
      "executor": "codex",
      "root": "{codex_home}/generated_images",
      "select": "entries",
      "glob": "*",
      "days": 30,
      "keep_latest": 3
    },
    {
      "id": "hermes-backups",
      "executor": "hermes",
      "root": "{hermes_home}/backups",
      "select": "entries",
      "glob": "*",
      "days": 30,
      "keep_latest": 3
    },
    {
      "id": "hermes-terminal-output",
      "executor": "hermes",
      "root": "{hermes_home}/cache/terminal-output",
      "select": "files",
      "glob": "*",
      "days": 14,
      "keep_latest": 3
    },
    {
      "id": "hermes-exec-output",
      "executor": "hermes",
      "root": "{hermes_home}/cache/exec",
      "select": "files",
      "glob": "*",
      "days": 14,
      "keep_latest": 3
    },
    {
      "id": "hermes-screen-captures",
      "executor": "hermes",
      "root": "{hermes_home}/cache/images",
      "select": "files",
      "glob": "*",
      "days": 14,
      "keep_latest": 3
    },
    {
      "id": "hermes-computer-use",
      "executor": "hermes",
      "root": "{hermes_home}/cache/computer_use",
      "select": "files",
      "glob": "*",
      "days": 14,
      "keep_latest": 3
    },
    {
      "id": "hermes-delegation-transcripts",
      "executor": "hermes",
      "root": "{hermes_home}/cache/delegation/live",
      "select": "entries",
      "glob": "*",
      "days": 14,
      "keep_latest": 3
    },
    {
      "id": "hermes-blocked-scripts",
      "executor": "hermes",
      "root": "{hermes_home}/cache/blocked-scripts",
      "select": "files",
      "glob": "*",
      "days": 30,
      "keep_latest": 3
    },
    {
      "id": "codegraph-indexes",
      "executor": "shared",
      "select": "codegraph",
      "days": 30,
      "keep_latest": 3
    }
  ],
  "hermes_desktop_chats": {
    "script": "hermes/discord/scripts/discord-project-hygiene.py",
    "keep_latest_per_project": 3,
    "max_days": 3,
    "include_archived": true,
    "run_records_grace_hours": 2,
    "run_record_sources": [
      "cron",
      "kanban",
      "oneshot"
    ],
    "discord_thread_idle_days": 3,
    "discord_thread_keep_latest": 3
  },
  "gam": {
    "policy_version": 2,
    "memory_mode": "auto-safe",
    "temporary_expiry_archive": true,
    "hard_delete": false,
    "stale_action": "report",
    "model_default_class": "durable",
    "cli_default_class": "standard",
    "standard_review_days": 90,
    "standard_episode_ttl_days": 30,
    "volatile_ttl_days": 7,
    "volatile_ttl_range": [
      1,
      7
    ],
    "due_soon_days": 14,
    "open_ceiling_days": 365,
    "open_ask_days": 14,
    "consolidation_user_turns": 5,
    "classifier": "agent-reviewed-portable-v1",
    "archive_protection": {
      "protect_tags": [
        "pinned",
        "important",
        "in-progress",
        "unresolved"
      ],
      "protect_types": [
        "decision",
        "preference",
        "convention"
      ],
      "importance_at_least": 0.8
    },
    "legacy_action": "report_classification_required",
    "source_checks": "agent_verified",
    "rank": "native_approximate",
    "type_map": {
      "fact": "fact",
      "decision": "decision",
      "solution": "lesson",
      "convention": "procedure",
      "session_summary": "episode",
      "preference": "fact",
      "reference": "fact",
      "entity": "fact",
      "project": "fact"
    }
  }
}
